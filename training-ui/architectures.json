        "vae_path": {
          "label": "VAE Path",
          "placeholder": "C:\\Anima\\split_files\\vae\\qwen_image_vae.safetensors",
          "cli_flag": "vae_path"
        }
      },
      "gen_params": {
        "flow_shift": {
          "label": "Flow Shift",
          "type": "number",
          "default": 3.0,
          "step": 0.5,
          "cli_flag": "discrete_flow_shift"
        }
      },
      "training_section": "anima_arguments",
      "all_in_one": false,
      "fsdp_transformer_cls": "Block"
    },
    "lumina": {
      "display_name": "Lumina",
      "network_modules": [
        "networks.lora_lumina"
      ],
